              "fruitId": {
                "enum": [
                  "APPLE",
                  "BANANA",
                  "ORANGE",
                  "PEAR",
                  "STRAWBERRY",
                  "GRAPE",
                  "WATERMELON",
                  "PINEAPPLE",
                  "PEACH",
                  "LEMON",
                  "CHERRY",
                  "MANGO"
                ]
              },
              "displayNameZh": {
