{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a620:catch-light:batch-metrics:1.5",
  "title": "CATCH_LIGHT Batch Metrics 1.5",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "H",
        "T",
        "F",
        "D"
      ],
      "properties": {
        "H": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "T": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "F": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "D": {
          "enum": [
            0,
            5,
            10
          ]
        }
      },
      "maxProperties": 4,
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "metricsVersion",
        "H",
        "T",
        "F",
        "D",
        "targetFruitId",
        "backgroundId",
        "configSetId",
        "generatorVersion",
        "difficultyStateId",
        "timingProfile",
        "contentVariantId",
        "waveProfileId",
        "seedKey",
        "scheduleSha256",
        "instanceAuditSha256",
        "targetTimeouts",
        "distractorAvoided",
        "doubleTargets",
        "doubleCompleted",
        "doubleFirstOnly",
        "totalObjectTouches",
        "blankTouches",
        "duplicateTouches",
        "consecutiveFailBefore",
        "consecutiveFailAfter"
      ],
      "properties": {
        "metricsVersion": {
          "const": "catch-light-batch-metrics-1"
        },
        "H": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "T": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "F": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "D": {
          "enum": [
            0,
            5,
            10
          ]
        },
        "targetFruitId": {
          "enum": [
            "APPLE",
            "BANANA",
            "ORANGE",
            "PEAR",
            "STRAWBERRY",
            "GRAPE",
            "WATERMELON",
            "PINEAPPLE",
            "PEACH",
            "LEMON",
            "CHERRY",
            "MANGO"
          ]
        },
        "backgroundId": {
          "type": "string",
          "pattern": "^BG0[1-8]$"
        },
        "configSetId": {
          "const": "catch-light-v1.5-w2-vertical-slices"
        },
        "generatorVersion": {
          "const": "catch-light-gen-1"
        },
        "difficultyStateId": {
          "type": "string",
          "pattern": "^DS[0-9]{2}$"
        },
        "timingProfile": {
          "enum": [
            "A",
            "C",
            "H"
          ]
        },
        "contentVariantId": {
          "type": "string",
          "pattern": "^DS[0-9]{2}-V[0-9]+$"
        },
        "waveProfileId": {
          "type": "string",
          "pattern": "^W[0-9A-Z-]+$"
        },
        "seedKey": {
          "type": "string",
          "pattern": "^CL-L[0-9]{3}-DS[0-9]{2}-V[0-9]+$"
        },
        "scheduleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instanceAuditSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "targetTimeouts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "distractorAvoided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "doubleTargets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "doubleCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "doubleFirstOnly": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "totalObjectTouches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "blankTouches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "duplicateTouches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "consecutiveFailBefore": {
          "enum": [
            0,
            1
          ]
        },
        "consecutiveFailAfter": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
