{
  "stateMachineVersion": "A620-RSM-1.1",
  "contractVersion": "A620-TRC-1.1",
  "clockProfile": "A620-UPTIME-MS-1",
  "initialState": "UNPREPARED",
  "terminalStates": [
    "RESULT_COMMITTED",
    "TERMINATED",
    "ERROR"
  ],
  "stateSet": [
    "UNPREPARED",
    "PREPARING",
    "READY",
    "START_SCHEDULED",
    "RUNNING",
    "PAUSE_SCHEDULED",
    "PAUSED",
    "RESUME_SCHEDULED",
    "FINALIZING",
    "RESULT_PENDING_COMMIT",
    "RESULT_COMMITTED",
    "TERMINATING",
    "TERMINATED",
    "ERROR"
  ],
  "sameTimestampPriority": [
    "TERMINATE",
    "DEADLINE",
    "PAUSE",
    "RESUME",
    "START"
  ],
  "engineeringDefaults": {
    "startLeadTimeMs": 500,
    "pauseLeadTimeMs": 300,
    "commandAcceptedTimeoutMs": 100,
    "minimumPauseSafetyMarginMs": 150,
    "resumeCountdownMs": 3000,
    "durationMs": 300000
  },
  "globalRules": [
    "QUERY_STATE is legal in all states except UNPREPARED and does not mutate state.",
    "Exact messageId and identical A620-JCS-1 bytes is idempotent replay; different bytes is protocol error.",
    "senderSeq is independently strictly increasing per sender for first-seen messages.",
    "Old executionAttempt, runtimeSessionId or monotonicEpochId is audit-only and cannot mutate business state.",
    "RUNTIME_ERROR from any nonterminal state transitions to ERROR and produces ExecutionOutcome only.",
    "Cocos self-triggers internal time boundaries; DEADLINE delivery confirms the already-known cutoff.",
    "RESULT_READY is legal only in FINALIZING.",
    "TERMINATE has priority over DEADLINE at the same uptime millisecond."
  ],
  "transitions": [
    {
      "from": [
        "UNPREPARED"
      ],
      "input": "PREPARE",
      "sender": "ANDROID_CONTROLLER",
      "to": "PREPARING",
      "expects": "READY"
    },
    {
      "from": [
        "PREPARING"
      ],
      "input": "READY",
      "sender": "COCOS_RUNTIME",
      "to": "READY"
    },
    {
      "from": [
        "READY"
      ],
      "input": "START",
      "sender": "ANDROID_CONTROLLER",
      "to": "START_SCHEDULED",
      "expects": "COMMAND_ACCEPTED"
    },
    {
      "from": [
        "START_SCHEDULED"
      ],
      "input": "EFFECTIVE_START_REACHED",
      "sender": "INTERNAL_CLOCK",
      "to": "RUNNING",
      "expects": "STARTED"
    },
    {
      "from": [
        "RUNNING"
      ],
      "input": "PAUSE",
      "sender": "ANDROID_CONTROLLER",
      "to": "PAUSE_SCHEDULED",
      "expects": "COMMAND_ACCEPTED"
    },
    {
      "from": [
        "PAUSE_SCHEDULED"
      ],
      "input": "EFFECTIVE_PAUSE_REACHED",
      "sender": "INTERNAL_CLOCK",
      "to": "PAUSED",
      "expects": "PAUSED"
    },
    {
      "from": [
        "PAUSED"
      ],
      "input": "RESUME",
      "sender": "ANDROID_CONTROLLER",
      "to": "RESUME_SCHEDULED",
      "expects": "COMMAND_ACCEPTED"
    },
    {
      "from": [
        "RESUME_SCHEDULED"
      ],
      "input": "RESUME_INPUT_BOUNDARY_REACHED",
      "sender": "INTERNAL_CLOCK",
      "to": "RUNNING",
      "expects": "RESUMED"
    },
    {
      "from": [
        "RUNNING"
      ],
      "input": "ACTIVE_TIME_REACHED_DURATION",
      "sender": "INTERNAL_CLOCK",
      "to": "FINALIZING"
    },
    {
      "from": [
        "FINALIZING"
      ],
      "input": "DEADLINE",
      "sender": "ANDROID_CONTROLLER",
      "to": "FINALIZING"
    },
    {
      "from": [
        "FINALIZING"
      ],
      "input": "RESULT_READY",
      "sender": "COCOS_RUNTIME",
      "to": "RESULT_PENDING_COMMIT"
    },
    {
      "from": [
        "RESULT_PENDING_COMMIT"
      ],
      "input": "ACK_RESULT_COMMITTED",
      "sender": "ANDROID_CONTROLLER",
      "to": "RESULT_COMMITTED"
    },
    {
      "from": [
        "UNPREPARED",
        "PREPARING",
        "READY",
        "START_SCHEDULED",
        "RUNNING",
        "PAUSE_SCHEDULED",
        "PAUSED",
        "RESUME_SCHEDULED",
        "FINALIZING",
        "RESULT_PENDING_COMMIT"
      ],
      "input": "TERMINATE",
      "sender": "ANDROID_CONTROLLER",
      "to": "TERMINATING",
      "expects": "COMMAND_ACCEPTED"
    },
    {
      "from": [
        "TERMINATING"
      ],
      "input": "TERMINATE_EFFECTIVE_REACHED",
      "sender": "INTERNAL_CLOCK",
      "to": "TERMINATED",
      "expects": "TERMINATED"
    },
    {
      "from": [
        "PREPARING",
        "READY",
        "START_SCHEDULED",
        "RUNNING",
        "PAUSE_SCHEDULED",
        "PAUSED",
        "RESUME_SCHEDULED",
        "FINALIZING",
        "RESULT_PENDING_COMMIT",
        "TERMINATING"
      ],
      "input": "RUNTIME_ERROR",
      "sender": "COCOS_RUNTIME",
      "to": "ERROR"
    },
    {
      "from": [
        "PREPARING",
        "READY",
        "START_SCHEDULED",
        "RUNNING",
        "PAUSE_SCHEDULED",
        "PAUSED",
        "RESUME_SCHEDULED",
        "FINALIZING",
        "RESULT_PENDING_COMMIT",
        "TERMINATING"
      ],
      "input": "COMMAND_REJECTED",
      "sender": "COCOS_RUNTIME",
      "to": "ERROR"
    }
  ],
  "nonMutatingInputLegality": {
    "QUERY_STATE": [
      "PREPARING",
      "READY",
      "START_SCHEDULED",
      "RUNNING",
      "PAUSE_SCHEDULED",
      "PAUSED",
      "RESUME_SCHEDULED",
      "FINALIZING",
      "RESULT_PENDING_COMMIT",
      "RESULT_COMMITTED",
      "TERMINATING",
      "TERMINATED",
      "ERROR"
    ],
    "STATE_SNAPSHOT": [
      "PREPARING",
      "READY",
      "START_SCHEDULED",
      "RUNNING",
      "PAUSE_SCHEDULED",
      "PAUSED",
      "RESUME_SCHEDULED",
      "FINALIZING",
      "RESULT_PENDING_COMMIT",
      "RESULT_COMMITTED",
      "TERMINATING",
      "TERMINATED",
      "ERROR"
    ],
    "HEARTBEAT": [
      "PREPARING",
      "READY",
      "START_SCHEDULED",
      "RUNNING",
      "PAUSE_SCHEDULED",
      "PAUSED",
      "RESUME_SCHEDULED",
      "FINALIZING",
      "RESULT_PENDING_COMMIT",
      "TERMINATING"
    ],
    "BATCH_CLOSED": [
      "RUNNING"
    ],
    "COMMAND_ACCEPTED": [
      "START_SCHEDULED",
      "PAUSE_SCHEDULED",
      "RESUME_SCHEDULED",
      "TERMINATING"
    ],
    "STARTED": [
      "RUNNING"
    ],
    "PAUSED": [
      "PAUSED"
    ],
    "RESUMED": [
      "RUNNING"
    ],
    "TERMINATED": [
      "TERMINATED"
    ]
  }
}
