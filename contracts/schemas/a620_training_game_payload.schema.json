{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a620:training-game-payload:1.1",
  "title": "A620 Training Game Payload 1.1",
  "type": "object",
  "required": [
    "gameCode",
    "gamePayloadVersion",
    "runtimeConfigHash",
    "designMaxLevel",
    "plannedBatchCount",
    "eligibleBatchCount",
    "eligibleBatches",
    "incompleteBatchAudit",
    "sessionStartLevel",
    "sessionEndLevel",
    "sessionHighestPresentedLevel",
    "sessionHighestPassedLevel",
    "nextStartLevel",
    "sessionRawScore",
    "sessionRawScoreMax",
    "actualTrainingMs",
    "gameMetrics"
  ],
  "properties": {
    "gameCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "gamePayloadVersion": {
      "const": "A620-GP-1.1"
    },
    "runtimeConfigHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "designMaxLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "plannedBatchCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "eligibleBatchCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "eligibleBatches": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "batchOrdinal",
          "closed",
          "decisionEligible",
          "levelBefore",
          "resultZone",
          "levelTransition",
          "levelAfter",
          "batchScore",
          "closedAtActiveMs",
          "batchPayloadSha256",
          "gameBatchMetrics"
        ],
        "properties": {
          "batchOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "closed": {
            "const": true
          },
          "decisionEligible": {
            "const": true
          },
          "levelBefore": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "resultZone": {
            "enum": [
              "UPGRADE",
              "HOLD",
              "FAIL"
            ]
          },
          "levelTransition": {
            "enum": [
              "UP",
              "HOLD",
              "RETRY",
              "DOWN",
              "HOLD_MAX",
              "HOLD_MIN"
            ]
          },
          "levelAfter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "batchScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "closedAtActiveMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          },
          "batchPayloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "gameBatchMetrics": {
            "type": "object",
            "maxProperties": 128
          }
        },
        "additionalProperties": false
      }
    },
    "incompleteBatchAudit": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "batchOrdinal",
          "levelBefore",
          "cutoffReason",
          "startedAtActiveMs",
          "cutoffAtActiveMs",
          "partialMetrics"
        ],
        "properties": {
          "batchOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "cutoffReason": {
            "const": "DEADLINE"
          },
          "startedAtActiveMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          },
          "cutoffAtActiveMs": {
            "const": 300000
          },
          "partialMetrics": {
            "type": "object",
            "maxProperties": 128
          },
          "levelBefore": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      }
    },
    "sessionStartLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sessionEndLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sessionHighestPresentedLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sessionHighestPassedLevel": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "nextStartLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "sessionRawScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 102400
    },
    "sessionRawScoreMax": {
      "type": "integer",
      "minimum": 100,
      "maximum": 102400
    },
    "actualTrainingMs": {
      "const": 300000
    },
    "gameMetrics": {
      "type": "object",
      "maxProperties": 256
    }
  },
  "additionalProperties": false
}
