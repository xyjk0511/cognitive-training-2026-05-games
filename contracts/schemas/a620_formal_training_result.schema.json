{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a620:formal-training-result:1.1",
  "title": "A620 Formal Training Result 1.1",
  "type": "object",
  "required": [
    "recordVersion",
    "resultId",
    "systemId",
    "deviceId",
    "taskId",
    "taskItemId",
    "executionAttempt",
    "runtimeSessionId",
    "gameCode",
    "packageVersion",
    "coreProtocolVersion",
    "contractVersion",
    "completionState",
    "syncState",
    "taskSlotState",
    "derivedQualityFlag",
    "resultPayloadSha256",
    "savedAtUtc",
    "savedAtUptimeMs",
    "gamePayload"
  ],
  "properties": {
    "recordVersion": {
      "const": "A620-TRR-1.1"
    },
    "resultId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "systemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "taskItemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "executionAttempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "gameCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "coreProtocolVersion": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "A620-TRC-1.1"
    },
    "completionState": {
      "const": "COMPLETE"
    },
    "syncState": {
      "enum": [
        "PENDING_UPLOAD",
        "WAITING_ACK",
        "SYNCED"
      ]
    },
    "taskSlotState": {
      "enum": [
        "OCCUPIED",
        "END_RECONCILING",
        "IDLE"
      ]
    },
    "derivedQualityFlag": {
      "enum": [
        "COMPLETE_BATCH_SET",
        "PARTIAL_ELIGIBLE_BATCHES",
        "NO_ELIGIBLE_BATCH"
      ]
    },
    "resultPayloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "savedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "savedAtUptimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gamePayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:a620:training-game-payload:1.1",
      "title": "A620 Training Game Payload 1.1",
      "type": "object",
      "required": [
        "gameCode",
        "gamePayloadVersion",
        "runtimeConfigHash",
        "plannedBatchCount",
        "eligibleBatchCount",
        "eligibleBatches",
        "incompleteBatchAudit",
        "sessionStartLevel",
        "sessionEndLevel",
        "sessionHighestPresentedLevel",
        "sessionHighestPassedLevel",
        "nextStartLevel",
        "sessionRawScore",
        "sessionRawScoreMax",
        "actualTrainingMs",
        "gameMetrics"
      ],
      "properties": {
        "gameCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "gamePayloadVersion": {
          "const": "A620-GP-1.1"
        },
        "runtimeConfigHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plannedBatchCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "eligibleBatchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleBatches": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "batchOrdinal",
              "closed",
              "decisionEligible",
              "levelBefore",
              "resultZone",
              "levelTransition",
              "levelAfter",
              "batchScore",
              "closedAtActiveMs",
              "batchPayloadSha256",
              "gameBatchMetrics"
            ],
            "properties": {
              "batchOrdinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "closed": {
                "const": true
              },
              "decisionEligible": {
                "const": true
              },
              "levelBefore": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "resultZone": {
                "enum": [
                  "UPGRADE",
                  "HOLD",
                  "FAIL"
                ]
              },
              "levelTransition": {
                "enum": [
                  "UP",
                  "HOLD",
                  "RETRY",
                  "DOWN",
                  "HOLD_MAX",
                  "HOLD_MIN"
                ]
              },
              "levelAfter": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "batchScore": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "closedAtActiveMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 300000
              },
              "batchPayloadSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "gameBatchMetrics": {
                "type": "object",
                "maxProperties": 128
              }
            },
            "additionalProperties": false
          }
        },
        "incompleteBatchAudit": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "batchOrdinal",
              "cutoffReason",
              "startedAtActiveMs",
              "cutoffAtActiveMs",
              "partialMetrics"
            ],
            "properties": {
              "batchOrdinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cutoffReason": {
                "const": "DEADLINE"
              },
              "startedAtActiveMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 300000
              },
              "cutoffAtActiveMs": {
                "const": 300000
              },
              "partialMetrics": {
                "type": "object",
                "maxProperties": 128
              }
            },
            "additionalProperties": false
          }
        },
        "sessionStartLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionEndLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionHighestPresentedLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionHighestPassedLevel": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "nextStartLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionRawScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 102400
        },
        "sessionRawScoreMax": {
          "type": "integer",
          "minimum": 100,
          "maximum": 102400
        },
        "actualTrainingMs": {
          "const": 300000
        },
        "gameMetrics": {
          "type": "object",
          "maxProperties": 256
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
