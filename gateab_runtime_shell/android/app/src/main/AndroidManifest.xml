<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".A620Application"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_a620"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.A620">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".training.TrainingActivity"
            android:exported="false"
            android:process=":training" />

        <receiver
            android:name=".training.TrainingControlReceiver"
            android:exported="false" />

        <service
            android:name=".ControllerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local durable controller and five-minute deadline scheduler active while the isolated training UI is foreground." />
        </service>

        <service
            android:name=".training.TrainingRuntimeService"
            android:exported="false"
            android:process=":training"
            android:stopWithTask="false" />
    </application>
</manifest>
